# Optional locally; required on Vercel. Use a pooled PostgreSQL connection URL.
DATABASE_URL=

# Shared team password. Required in production; minimum 16 characters.
STUDIO_PASSWORD=

# Random session signing secret. Required with a password; at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
