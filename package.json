{
  "name": "sa-studio",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 5173",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1 --port 5173",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/migrate.mjs",
    "test": "tsx --test tests/*.test.ts",
    "format": "prettier --write app components lib scripts tests db/index.ts README.md *.json .github"
  },
  "dependencies": {
    "@next/env": "16.3.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "pg": "^8.16.3",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/pg": "^8.15.5",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "prettier": "^3.9.10",
    "tsx": "^4.20.5",
    "typescript": "5.9.3"
  },
  "type": "module",
  "description": "A shared design studio for versioned HTML prototypes and developer handoffs."
}
